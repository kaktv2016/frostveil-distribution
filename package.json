{
  "name": "frostveil-distribution-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build/core.mjs",
    "test": "node --test tests/*.test.mjs",
    "audit": "node scripts/validate/source.mjs",
    "prepare:synthetic": "node scripts/build/prepare.mjs synthetic",
    "verify": "node scripts/verify/release.mjs",
    "prepare:offline": "node scripts/build/prepare.mjs offline"
  },
  "dependencies": {
    "semver": "7.8.5"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "@types/node": "24.10.1",
    "@types/semver": "7.8.0"
  }
}
